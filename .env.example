# Private Key (NEVER commit your real private key!)
# Get this from your wallet (MetaMask, etc.)
PRIVATE_KEY=your_private_key_here

# RPC URLs
# Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR-INFURA-PROJECT-ID

# Ethereum Mainnet
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR-INFURA-PROJECT-ID

# Polygon Mumbai Testnet
POLYGON_MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com

# Polygon Mainnet
POLYGON_RPC_URL=https://polygon-rpc.com

# BSC Testnet
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# BSC Mainnet
BSC_RPC_URL=https://bsc-dataseed1.binance.org

# Block Explorer API Keys
# Get from: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Get from: https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Gas Reporter
# Set to "true" to enable gas reporting
REPORT_GAS=false

# Get from: https://coinmarketcap.com/api/
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Deployment Configuration
# Initial supply for CassoneCoin (in tokens, not wei)
INITIAL_SUPPLY=1000000
